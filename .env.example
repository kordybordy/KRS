KRS_EMAIL_USERNAME=
KRS_EMAIL_PASSWORD=
KRS_EMAIL_FROM=
KRS_EMAIL_TO=
KRS_EMAIL_USE_TLS=true
KRS_EMAIL_USE_SSL=false
KRS_EMAIL_SUBJECT_PREFIX=KRS Monitor
KRS_EMAIL_MAX_DETAILS=10
